<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TaskbarQuota.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    xmlns:vm="using:TaskbarQuota.ViewModels"
    xmlns:controls="using:TaskbarQuota.Controls"
    xmlns:loc="using:TaskbarQuota.Localization"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  Padding="0,0,0,24"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Stretch">
        <StackPanel Spacing="6" HorizontalAlignment="Stretch">

            <TextBlock Text="{loc:Zh Text=Settings}" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,8"/>

            <!-- Explains a refused pin, matching DashboardPage. A tooltip is no use here: the user has just
                 selected a destination and watched it revert, so the reason has to appear unprompted. -->
            <muxc:InfoBar x:Name="PinBlockedBar"
                          Severity="Warning"
                          Title="无法固定此服务"
                          IsOpen="False"
                          IsClosable="True"
                          Margin="0,0,0,4"/>

            <TextBlock Text="{loc:Zh Text=Appearance}" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,2"/>

            <tk:SettingsCard Header="{loc:Zh Text=Theme}" Description="选择 TaskbarQuota 的外观主题。">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE771;"/>
                </tk:SettingsCard.HeaderIcon>
                <ComboBox x:Name="ThemeCombo" SelectionChanged="OnThemeChanged" MinWidth="160">
                    <ComboBoxItem Content="{loc:Zh Text='Use system setting'}" Tag="Default"/>
                    <ComboBoxItem Content="{loc:Zh Text=Light}" Tag="Light"/>
                    <ComboBoxItem Content="{loc:Zh Text=Dark}" Tag="Dark"/>
                </ComboBox>
            </tk:SettingsCard>

            <tk:SettingsCard Header="{loc:Zh Text='Widget layout'}" Description="选择紧凑用量视图的布局（进度条、百分比或两者同时显示）。">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE71D;"/>
                </tk:SettingsCard.HeaderIcon>
                <ComboBox x:Name="WidgetModeCombo" SelectionChanged="OnWidgetModeChanged" MinWidth="180">
                    <ComboBoxItem Content="{loc:Zh Text='Bars only'}" Tag="BarsOnly"/>
                    <ComboBoxItem Content="{loc:Zh Text='Percentages only'}" Tag="PercentagesOnly"/>
                    <ComboBoxItem Content="{loc:Zh Text='Bars and percentages'}" Tag="BarsAndPercentages"/>
                </ComboBox>
            </tk:SettingsCard>

            <tk:SettingsCard Header="{loc:Zh Text='Percentage display'}" Description="选择百分比显示已用额度还是剩余额度。">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE9D2;"/>
                </tk:SettingsCard.HeaderIcon>
                <ComboBox x:Name="PercentageModeCombo" SelectionChanged="OnPercentageModeChanged" MinWidth="160">
                    <ComboBoxItem Content="{loc:Zh Text=Consumed}" Tag="Consumed"/>
                    <ComboBoxItem Content="{loc:Zh Text=Remaining}" Tag="Remaining"/>
                </ComboBox>
            </tk:SettingsCard>

            <tk:SettingsCard Header="{loc:Zh Text='Reset and expiry time display'}"
                             Description="选择任务栏与悬浮窗中额度重置及可用重置过期时间显示为剩余倒计时，还是具体时钟/日期。">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE823;"/>
                </tk:SettingsCard.HeaderIcon>
                <ComboBox x:Name="ResetDisplayModeCombo"
                          SelectionChanged="OnResetDisplayModeChanged"
                          MinWidth="160"
                          AutomationProperties.Name="{loc:Zh Text='Reset and expiry time display'}"
                          AutomationProperties.AutomationId="ResetDisplayModeCombo">
                    <ComboBoxItem Content="{loc:Zh Text=Countdown}" Tag="Countdown"/>
                    <ComboBoxItem Content="{loc:Zh Text='Absolute time'}" Tag="AbsoluteTime"/>
                </ComboBox>
            </tk:SettingsCard>

            <tk:SettingsCard Header="{loc:Zh Text='Hide widget when no AI app is focused'}"
                             Description="切换到浏览器或其他应用时淡出当前服务；返回 AI 应用时恢复。已固定的服务始终保持显示。">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE890;"/>
                </tk:SettingsCard.HeaderIcon>
                <ToggleSwitch x:Name="HideWhenUnfocusedToggle"
                              AutomationProperties.Name="{loc:Zh Text='Hide widget when no AI app is focused'}"
                              Toggled="OnHideWhenUnfocusedToggled"/>
            </tk:SettingsCard>

            <tk:SettingsCard Header="{loc:Zh Text='Where to show usage'}"
                             Description="任务栏模式会将紧凑小组件放在托盘旁；悬浮模式使用相同布局的原生亚克力置顶窗口。滚轮可调节透明强度，右键可返回任务栏模式。">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8A7;"/>
                </tk:SettingsCard.HeaderIcon>
                <ComboBox x:Name="WidgetSurfaceCombo"
                          SelectionChanged="OnWidgetSurfaceChanged"
                          MinWidth="200"
                          AutomationProperties.Name="{loc:Zh Text='Where to show usage'}"
                          AutomationProperties.AutomationId="WidgetSurfaceCombo">
                    <ComboBoxItem Content="{loc:Zh Text='In the taskbar'}" Tag="Taskbar"/>
                    <ComboBoxItem Content="{loc:Zh Text='Floating always-on-top window'}" Tag="Floating"/>
                </ComboBox>
            </tk:SettingsCard>

            <tk:SettingsCard x:Name="TaskbarPlacementCard"
                             Header="{loc:Zh Text='Taskbar screens'}"
                             Description="可在每个任务栏显示相同用量、选择一个屏幕，或让每个屏幕保留各自的活动服务。多屏时，自适应模式还允许将已固定服务指定到某个屏幕。">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE7F4;"/>
                </tk:SettingsCard.HeaderIcon>
                <ComboBox x:Name="TaskbarPlacementCombo"
                          SelectionChanged="OnTaskbarPlacementChanged"
                          MinWidth="200"
                          AutomationProperties.Name="{loc:Zh Text='Taskbar screens'}"
                          AutomationProperties.AutomationId="TaskbarPlacementCombo"/>
            </tk:SettingsCard>

            <tk:SettingsCard x:Name="FloatingOpacityCard"
                             Header="{loc:Zh Text='Floating acrylic strength'}"
                             Description="调节原生亚克力背景的不透明度；数值越低，后方模糊桌面越明显。">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE790;"/>
                </tk:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <!-- Slider range is applied in code — XAML Minimum/Maximum on RangeBase is unsafe. -->
                    <Grid x:Name="FloatingOpacitySliderHost"
                          Width="180"
                          VerticalAlignment="Center"
                          AutomationProperties.Name="{loc:Zh Text='Floating acrylic strength'}"/>
                    <TextBlock x:Name="FloatingOpacityLabel"
                               VerticalAlignment="Center"
                               MinWidth="40"
                               Style="{StaticResource BodyTextBlockStyle}"/>
                </StackPanel>
            </tk:SettingsCard>

            <TextBlock Text="{loc:Zh Text=Providers}" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,16,0,2"/>
            <tk:SettingsCard Header="{loc:Zh Text='Hide unavailable providers'}"
                             Description="自动隐藏明确报告为尚未安装的服务；需要登录或等待应用启动的服务会保留，以便修复。">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE7B8;"/>
                </tk:SettingsCard.HeaderIcon>
                <ToggleSwitch x:Name="AutoHideUnavailableToggle"
                              AutomationProperties.Name="{loc:Zh Text='Hide unavailable providers'}"
                              Toggled="OnAutoHideUnavailableToggled"/>
            </tk:SettingsCard>

            <TextBlock Text="选择要显示在仪表板和用量小组件中的服务。"
                       Opacity="0.7"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,4"/>

            <StackPanel x:Name="ProviderSettingsPanel" Spacing="4"/>

            <TextBlock Text="{loc:Zh Text=Behavior}" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,16,0,2"/>
            <tk:SettingsCard Header="{loc:Zh Text='Open at startup'}" Description="随 Windows 启动 TaskbarQuota，并仅显示用量小组件。">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE7F4;"/>
                </tk:SettingsCard.HeaderIcon>
                <ToggleSwitch x:Name="StartupToggle"
                              AutomationProperties.Name="{loc:Zh Text='Open at startup'}"
                              Toggled="OnStartupToggled"/>
            </tk:SettingsCard>

            <TextBlock Text="{loc:Zh Text=Notifications}" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,16,0,2"/>
            <tk:SettingsCard Header="{loc:Zh Text='Quota alerts'}" Description="当用量超过设定阈值时显示 Windows 通知。">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xEA8F;"/>
                </tk:SettingsCard.HeaderIcon>
                <ToggleSwitch x:Name="QuotaAlertsToggle"
                              AutomationProperties.Name="{loc:Zh Text='Enable quota alerts'}"
                              Toggled="OnQuotaAlertsToggled"/>
            </tk:SettingsCard>

            <tk:SettingsCard Header="{loc:Zh Text='Quota replenishment'}"
                             Description="当可用额度明显增加或用量周期刷新时通知。">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE7E7;"/>
                </tk:SettingsCard.HeaderIcon>
                <ToggleSwitch x:Name="QuotaReplenishmentToggle"
                              AutomationProperties.Name="{loc:Zh Text='Notify when quota is replenished'}"
                              Toggled="OnQuotaReplenishmentToggled"/>
            </tk:SettingsCard>

            <tk:SettingsCard Header="{loc:Zh Text='Changes since last session'}"
                             Description="启动后，如果额度比 TaskbarQuota 上次实时读数增加则通知。需要先启用额度恢复通知。">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE823;"/>
                </tk:SettingsCard.HeaderIcon>
                <ToggleSwitch x:Name="CrossSessionReplenishmentToggle"
                              AutomationProperties.Name="{loc:Zh Text='Notify about quota increases since the last session'}"
                              Toggled="OnCrossSessionReplenishmentToggled"/>
            </tk:SettingsCard>

            <tk:SettingsCard Header="{loc:Zh Text='Warning threshold'}" Description="当某个用量周期的已用百分比达到此值时通知。">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE7BA;"/>
                </tk:SettingsCard.HeaderIcon>
                <NumberBox x:Name="WarningThresholdBox"
                           AutomationProperties.Name="{loc:Zh Text='Warning threshold'}"
                           Minimum="1"
                           Maximum="99"
                           SmallChange="1"
                           LargeChange="5"
                           SpinButtonPlacementMode="Compact"
                           ValueChanged="OnWarningThresholdChanged"
                           Width="120"/>
            </tk:SettingsCard>

            <tk:SettingsCard Header="{loc:Zh Text='Critical threshold'}" Description="当已用百分比达到这个更高阈值时再次通知。">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE814;"/>
                </tk:SettingsCard.HeaderIcon>
                <NumberBox x:Name="CriticalThresholdBox"
                           AutomationProperties.Name="{loc:Zh Text='Critical threshold'}"
                           Minimum="2"
                           Maximum="100"
                           SmallChange="1"
                           LargeChange="5"
                           SpinButtonPlacementMode="Compact"
                           ValueChanged="OnCriticalThresholdChanged"
                           Width="120"/>
            </tk:SettingsCard>

            <tk:SettingsCard Header="{loc:Zh Text='Notification cooldown'}" Description="TaskbarQuota 重复同一警报前的最短间隔（分钟）。">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE823;"/>
                </tk:SettingsCard.HeaderIcon>
                <NumberBox x:Name="AlertCooldownBox"
                           AutomationProperties.Name="{loc:Zh Text='Notification cooldown'}"
                           Minimum="1"
                           Maximum="1440"
                           SmallChange="1"
                           LargeChange="15"
                           SpinButtonPlacementMode="Compact"
                           ValueChanged="OnAlertCooldownChanged"
                           Width="120"/>
            </tk:SettingsCard>

            <TextBlock Text="{loc:Zh Text=Credentials}" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,16,0,2"/>
            <TextBlock Text="所有服务都会自动检测凭据。如果某个服务检测失败，请使用其仪表板卡片中的“修复”按钮。"
                       Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" Margin="0,0,0,4"/>

            <TextBlock Text="{loc:Zh Text=About}" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,16,0,2"/>
            <tk:SettingsCard Description="{loc:Zh Text='Native WinUI widget for AI coding-tool usage.'}">
                <tk:SettingsCard.Header>
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Border Width="40" Height="40"
                                CornerRadius="4">
                            <Image Source="ms-appx:///Assets/TaskBarQuota.png" Stretch="UniformToFill"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="TaskbarQuota" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <TextBlock x:Name="VersionLabel"
                                       Opacity="0.6"
                                       Style="{StaticResource CaptionTextBlockStyle}"/>
                        </StackPanel>
                    </StackPanel>
                </tk:SettingsCard.Header>
            </tk:SettingsCard>

            <controls:UpdateActionBar x:Name="SettingsUpdateBar"
                                        Placement="Settings"/>

        </StackPanel>
    </ScrollViewer>
</Page>
